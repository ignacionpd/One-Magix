# ==========================================================
#  One Magix - Configuración de Apache
# ==========================================================

# No mostrar el listado de archivos de una carpeta
Options -Indexes

# Página principal
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Las carpetas internas no se pueden abrir desde el navegador:
    # se muestra nuestra página de error 403.
    RewriteRule ^(config|controllers|views)(/.*)?$ index.php?error=403 [L,QSA]

    # Si la dirección no es un archivo ni una carpeta que exista,
    # se muestra nuestra página de error 404.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php?error=404 [L,QSA]
</IfModule>

# Si el servidor falla (error 500), mostramos un texto amable
ErrorDocument 500 "Lo sentimos, hubo un problema en el servidor. Probá de nuevo en unos minutos."
